# =================================================
#   SISTEMA LOGISTICO - UBERDRONES v2.0
#   Makefile
# =================================================

CC      = gcc
CFLAGS  = -Wall -Wextra -std=c99
TARGET  = uberdrones
SRC     = uberdrones.c
MAP     = mapa.txt

# Detecta o sistema operacional
ifeq ($(OS), Windows_NT)
    TARGET_EXE = $(TARGET).exe
    RM         = del /Q
    RUN        = $(TARGET_EXE)
else
    TARGET_EXE = $(TARGET)
    RM         = rm -f
    RUN        = ./$(TARGET_EXE)
endif

# ── Alvo padrao: compila o projeto ──────────────
all: $(TARGET_EXE)

$(TARGET_EXE): $(SRC)
	$(CC) $(CFLAGS) -o $(TARGET_EXE) $(SRC)
	@echo ""
	@echo "  Compilacao concluida -> $(TARGET_EXE)"
	@echo "  Use 'make run' para executar."
	@echo ""

# ── Executa o programa ───────────────────────────
run: $(TARGET_EXE) $(MAP)
	$(RUN)

# ── Cria um mapa.txt de exemplo se nao existir ──
$(MAP):
	@echo "  Criando $(MAP) de exemplo..."
	@echo 4         >  $(MAP)
	@echo 0 1 15    >> $(MAP)
	@echo 0 2 30    >> $(MAP)
	@echo 1 3 10    >> $(MAP)
	@echo 2 3 25    >> $(MAP)
	@echo "  $(MAP) criado com sucesso!"

# ── Remove os arquivos gerados ───────────────────
clean:
	$(RM) $(TARGET_EXE)
	@echo "  Limpeza concluida."

# ── Recompila do zero ────────────────────────────
rebuild: clean all

# ── Mostra ajuda ─────────────────────────────────
help:
	@echo ""
	@echo "  Alvos disponiveis:"
	@echo "    make          -> compila o projeto"
	@echo "    make run      -> compila (se necessario) e executa"
	@echo "    make clean    -> remove o executavel gerado"
	@echo "    make rebuild  -> limpa e recompila do zero"
	@echo "    make help     -> exibe esta mensagem"
	@echo ""

.PHONY: all run clean rebuild help
